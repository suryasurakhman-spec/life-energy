{
  "expo": {
    "name": "Life Energy",
    "slug": "beapp",
    "version": "1.0.0",
    "scheme": "beapp",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "platforms": [
      "ios",
      "android"
    ],
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "com.beapp.beapp",
      "infoPlist": {
        "NSCameraUsageDescription": "We read prices through your camera. Images never leave your phone."
      },
      "usesAppleSignIn": true
    },
    "android": {
      "package": "com.beapp.beapp",
      "adaptiveIcon": {
        "foregroundImage": "./assets/images/adaptive-icon.png",
        "backgroundColor": "#1A1714"
      },
      "permissions": [
        "android.permission.CAMERA"
      ]
    },
    "androidStatusBar": {
      "backgroundColor": "#FAF8F5",
      "barStyle": "dark-content"
    },
    "plugins": [
      "expo-router",
      "expo-secure-store",
      [
        "react-native-vision-camera",
        {
          "cameraPermissionText": "We read prices through your camera. Images never leave your phone.",
          "enableMicrophonePermission": false
        }
      ],
      "expo-apple-authentication",
      [
        "expo-splash-screen",
        {
          "image": "./assets/images/splash-icon.png",
          "imageWidth": 240,
          "resizeMode": "contain",
          "backgroundColor": "#1A1714"
        }
      ]
    ],
    "userInterfaceStyle": "automatic",
    "experiments": {
      "typedRoutes": true
    },
    "extra": {
      "router": {
        "origin": false
      },
      "eas": {
        "projectId": "c79da0cc-e7da-41a0-878e-7307b386f448"
      }
    },
    "owner": "suryazuran"
  }
}
